NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Production database: the Postgres connection string (Neon on Vercel sets this for you).
# Leave it empty locally to use PGlite, a Postgres that runs inside Node, in data/pglite.
DATABASE_URL=

# Local demo accounts and example parcels (admin@iza.test, sipho@iza.test, cornershop@iza.test,
# lindiwe@iza.test). Never set these on a production deployment.
IZA_SEED_DEMO=1
IZA_SEED_PASSWORD=choose-a-password-of-8-or-more-characters
